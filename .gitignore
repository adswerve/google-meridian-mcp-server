__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
build/
*.egg-info/
.eggs/
*.egg
.env
.pytest_cache/
.ruff_cache/
*.log
.DS_Store
Thumbs.db
*.tmp
*.swp
/tmp/

.github/
# references/ is local working material. Three synthesis documents are published;
# the vendored Meridian clone, an unattributed export script, and the local
# AGENTS.md overflow notes stay out.
references/*
!references/module-map.md
!references/skills-research.md
!references/research-deferred-work.md
docs/
# Skill references are served as MCP resources and must be tracked.
!skills/meridian-analyst/references/
!skills/meridian-analyst/references/**
.superpowers/
.vscode/
models/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Terraform (per-client inputs + state are never committed)
deploy/terraform/**/.terraform/*
deploy/terraform/**/.terraform.lock.hcl
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/*.tfvars
!deploy/terraform/**/*.tfvars.example
deploy/terraform/**/backend.hcl
!deploy/terraform/**/backend.hcl.example
# Saved plan files: binary, and each one embeds a full tfstate snapshot.
deploy/terraform/**/tfplan
deploy/terraform/**/*.tfplan
crash.log
.claude/settings.json
.mcp.json
