# Copy this file to .env in the repository root.
#
# The runtime loads .env from the repo root explicitly (see config.py), so it
# must live there. Every variable is optional unless marked "required"; the
# value shown is the code default. Commented-out lines document without setting.

# A local-dev .env is five lines:
#   MCP_TRANSPORT=streamable-http
#   MCP_HOST=127.0.0.1
#   PERSISTENCE_BACKEND=local
#   LOCAL_MODELS_ROOT=./models
#   OPTIMIZATION_TIER=local

# ── Required ───────────────────────────────────────────────────────
# WHERE fitted Meridian model files live. "local" reads them from
# LOCAL_MODELS_ROOT; "gcs" reads them from gs://GCS_BUCKET/GCS_MODELS_PREFIX.
# It also decides where optimization-run state is stored -- the run registry
# follows it. Any other value fails startup validation.
PERSISTENCE_BACKEND=local

# Required when PERSISTENCE_BACKEND=local. Root directory of .binpb model files
# (.pkl is not supported). Nested layouts like ./models/geo-revenue/model.binpb
# work.
LOCAL_MODELS_ROOT=./models

# Both required when PERSISTENCE_BACKEND=gcs. Authenticate first with
# `gcloud auth application-default login`.
# GCS_BUCKET=my-bucket
# GCS_MODELS_PREFIX=models/

# ── Common ─────────────────────────────────────────────────────────
# "streamable-http" (default) or "stdio".
MCP_TRANSPORT=streamable-http

# Bind address for streamable HTTP. Code default 0.0.0.0 (all interfaces),
# correct for containers; 127.0.0.1 for local dev.
MCP_HOST=127.0.0.1

# Listen port, default 8000. Cloud Run injects this automatically.
# PORT=8000

# Local directory where GCS-backed models are materialised, default
# /tmp/mmm-models. On Cloud Run /tmp is tmpfs, so materialized models cost RAM;
# point this at a real volume when sizing your own host.
# MODEL_CACHE_ROOT=/tmp/mmm-models

# Cache repeated analysis results in-process. Accepts 1/true/yes/on.
RESULT_CACHE_ENABLED=true

# TTL (seconds) for cached analysis results. Unset = no expiry; positive if set.
# RESULT_CACHE_TTL_SECONDS=3600

# WHERE optimizations execute. One of:
#   local      subprocess on the server host (default)
#   cloud_cpu  always the CPU Cloud Run Job
#   cloud_gpu  always the GPU Cloud Run Job
#   cloud_auto CPU or GPU, chosen by problem size
# A request may pass compute_tier explicitly, but only a tier this deployment
# runs ("auto" always works); anything else is rejected. Every cloud_* value
# requires PERSISTENCE_BACKEND=gcs and the Cloud Run coordinates below.
OPTIMIZATION_TIER=local

# Max optimization worker launches in flight at once -- Cloud Run Job executions
# on a cloud tier, local subprocesses on the local tier. Over-cap runs are
# queued, not rejected. With the analysis semaphore removed this is the only
# in-process concurrency bound left. Positive integer.
OPTIMIZATION_MAX_PARALLEL=2

# Directory for local optimization run files (PERSISTENCE_BACKEND=local).
OPTIMIZATION_RUNS_ROOT=./optimizations

# Key prefix for optimization run files in the bucket (PERSISTENCE_BACKEND=gcs).
# Optional; defaults to optimizations/.
# OPTIMIZATION_GCS_PREFIX=optimizations/

# Max seconds an analysis subprocess may run before it is killed and the call
# returns worker_timeout. Track your platform's request timeout: on Cloud Run
# the service timeout is derived from this (see deploy/terraform).
ANALYSIS_WORKER_TIMEOUT=300

# ── Cloud tiers only ───────────────────────────────────────────────
# Required when OPTIMIZATION_TIER is any cloud_* value, alongside a gcs
# persistence backend. cloud_auto needs BOTH job names.
# CLOUD_RUN_PROJECT=your-gcp-project
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_JOB_CPU=meridian-opt-cpu
# CLOUD_RUN_JOB_GPU=meridian-opt-gpu

# ── Not configurable ───────────────────────────────────────────────
# The server and its workers run Meridian on JAX with 64-bit precision.
# MERIDIAN_BACKEND is a module constant in execution/base_subprocess.py and
# MERIDIAN_ENABLE_JAX_X64 is pinned to "true" there, in all three Dockerfiles,
# and in the Terraform service and job env. Setting either has no effect.
