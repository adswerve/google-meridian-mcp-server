# Copy this file to .env in the repository root.
#
# The runtime loads .env from the repo root explicitly (see config.py), so it
# must live there. Every variable below is optional unless noted "required";
# the value shown is the code default (what you get if the variable is unset).
# Commented-out lines document a variable without setting it.

# ── Transport ──────────────────────────────────────────────────────
# MCP transport mode: "streamable-http" (default) or "stdio".
MCP_TRANSPORT=streamable-http

# Bind address for streamable HTTP.
# Code default when unset is 0.0.0.0 (bind all interfaces) — correct for
# containers. For local dev we suggest 127.0.0.1 (loopback only).
MCP_HOST=127.0.0.1

# Listen port. The server reads PORT first, then MCP_PORT, defaulting to 8000.
# Cloud Run injects PORT automatically, which therefore wins in containers.
MCP_PORT=8000

# ── Persistence backend ───────────────────────────────────────────
# Selects WHERE fitted Meridian model files are stored and loaded from.
#   "local" (default) → read models from LOCAL_MODELS_ROOT on local disk.
#   "gcs"             → read models from gs://GCS_BUCKET/GCS_MODELS_PREFIX.
# It also sets the DEFAULT for REGISTRY_BACKEND (the optimization-run store):
# if REGISTRY_BACKEND is unset it inherits this value. And it gates which
# other variables are required at startup:
#   local → LOCAL_MODELS_ROOT required
#   gcs   → GCS_BUCKET and GCS_MODELS_PREFIX required
# It does NOT choose where optimizations execute — that is
# OPTIMIZATION_ALLOWED_TIERS. Any value other than local/gcs fails validation.
PERSISTENCE_BACKEND=local

# ── Local backend settings ────────────────────────────────────────
# Required when PERSISTENCE_BACKEND=local. No default — startup fails if unset.
# Root directory containing Meridian model files (.binpb or .pkl).
# Nested layouts such as ./models/geo-revenue/model.binpb are supported.
LOCAL_MODELS_ROOT=./models

# ── GCS backend settings ─────────────────────────────────────────
# Both required when PERSISTENCE_BACKEND=gcs (no defaults). Authenticate
# locally first with: gcloud auth application-default login
# GCS_BUCKET=my-project.appspot.com
# GCS_MODELS_PREFIX=models/

# ── Cache settings ────────────────────────────────────────────────
# Local directory where remote (GCS) model files are materialised. Default
# /tmp/mmm-models. Ignored by the local backend beyond internal bookkeeping.
MODEL_CACHE_ROOT=/tmp/mmm-models

# How long (seconds) model-catalog discovery results are cached. Default 7200
# (2h). Must be a positive integer.
DISCOVERY_TTL_SECONDS=7200

# Enable transparent internal caching of repeated analysis results. Default
# true. Accepts 1/true/yes/on (case-insensitive) as true.
RESULT_CACHE_ENABLED=true

# TTL (seconds) for cached analysis results. Unset (default) = no expiry.
# Must be a positive integer when set.
# RESULT_CACHE_TTL_SECONDS=3600

# ── Optimization module (local tier) ──────────────────────────────
# Where optimization-run state/results are stored. Unset (default) → follows
# PERSISTENCE_BACKEND. Set explicitly to "local" or "gcs" to decouple them
# (cloud tiers require "gcs").
REGISTRY_BACKEND=local

# Directory for local optimization run files (REGISTRY_BACKEND=local).
# Default ./optimizations.
OPTIMIZATION_RUNS_ROOT=./optimizations

# Comma-separated compute tiers the server permits: local, cloud_cpu,
# cloud_gpu. Default "local". Must list at least one valid tier.
OPTIMIZATION_ALLOWED_TIERS=local

# Tier picked when a request does not specify one. Default "auto" (choose the
# cheapest allowed tier by problem size). Any explicit value must be in the
# allowed-tiers list above.
OPTIMIZATION_DEFAULT_TIER=auto

# Max optimization runs executed concurrently. Default 2. Must be positive.
OPTIMIZATION_MAX_PARALLEL=2

# Problem-size cutoffs "T_local,T_gpu" (two ascending positive ints) used by
# the "auto" tier: size = geos × time_periods × channels × posterior_samples.
# Default 10000000,100000000 (1e7, 1e8).
OPTIMIZATION_SIZE_THRESHOLDS=10000000,100000000

# Meridian backend for local-tier runs. Default "tensorflow".
OPTIMIZATION_BACKEND_LOCAL=tensorflow

# A RUNNING run whose heartbeat is older than this (seconds) is treated as
# crashed and reconciled to failed. Default 60.
OPTIMIZATION_HEARTBEAT_STALE_SECONDS=60

# ── Optimization module — cloud tiers ─────────────────────────────
# To offload heavy runs to Cloud Run Jobs, allow cloud tiers (this requires
# REGISTRY_BACKEND=gcs + the Cloud Run coordinates below):
# OPTIMIZATION_ALLOWED_TIERS=local,cloud_cpu,cloud_gpu

# Meridian backend for cloud-tier runs. Defaults "jax" for both.
OPTIMIZATION_BACKEND_CLOUD_CPU=jax
OPTIMIZATION_BACKEND_CLOUD_GPU=jax

# REGISTRY_BACKEND=gcs
# Key prefix for optimization run files in the bucket. Default "optimizations/".
# OPTIMIZATION_GCS_PREFIX=optimizations/
# Cloud Run coordinates (no defaults; required only for cloud tiers):
# CLOUD_RUN_PROJECT=example-dev-project
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_JOB_CPU=meridian-opt-cpu
# CLOUD_RUN_JOB_GPU=meridian-opt-gpu
